{
  "version": "0.2-webapps",
  "review_status": "Provisional until the full M2 label-frequency and description audit is complete.",
  "classes": [
    "Bug",
    "Feature",
    "Documentation",
    "Question"
  ],
  "policy": {
    "single_target_only": true,
    "case_insensitive": true,
    "preserve_original_labels": true,
    "exclude_cross_class_conflicts": true,
    "note": "An issue is classification-eligible only when its labels map to exactly one standardized class. Multiple source labels mapping to the same class are allowed."
  },
  "global": {
    "Bug": [
      "bug",
      "type: bug",
      "type/bug",
      "kind/bug",
      "c-bug"
    ],
    "Feature": [
      "feature",
      "feature request",
      "feature-request",
      "enhancement",
      "type: enhancement",
      "type: new feature",
      "kind/feature",
      "c-feature-request"
    ],
    "Documentation": [
      "documentation",
      "docs",
      "doc",
      "type: documentation",
      "kind/documentation",
      "t-doc"
    ],
    "Question": [
      "question",
      "type: question",
      "kind/support",
      "support",
      "c-question"
    ]
  },
  "issue_types": {
    "Bug": [
      "Bug"
    ],
    "Feature": [
      "Feature"
    ],
    "Documentation": [
      "Documentation"
    ],
    "Question": [
      "Question",
      "Support"
    ]
  },
  "repository_overrides": {
    "microsoft/vscode": {
      "Question": [
        "*question",
        "*dev-question"
      ],
      "Feature": [
        "feature-request"
      ]
    },
    "microsoft/TypeScript": {
      "Bug": [
        "Bug"
      ],
      "Feature": [
        "Suggestion",
        "API Request"
      ],
      "Documentation": [
        "Documentation"
      ],
      "Question": [
        "Question"
      ]
    },
    "flutter/flutter": {
      "Bug": [
        "type: bug"
      ],
      "Feature": [
        "type: new feature"
      ],
      "Documentation": [
        "a: documentation"
      ]
    },
    "kubernetes/kubernetes": {
      "Bug": [
        "kind/bug"
      ],
      "Feature": [
        "kind/feature"
      ],
      "Documentation": [
        "kind/documentation"
      ],
      "Question": [
        "kind/support"
      ]
    },
    "pandas-dev/pandas": {
      "Bug": [
        "Bug"
      ],
      "Feature": [
        "Enhancement"
      ],
      "Documentation": [
        "Docs"
      ]
    },
    "scikit-learn/scikit-learn": {
      "Bug": [
        "Bug"
      ],
      "Feature": [
        "New Feature",
        "Enhancement"
      ],
      "Documentation": [
        "Documentation"
      ],
      "Question": [
        "Question"
      ]
    },
    "huggingface/transformers": {
      "Bug": [
        "bug"
      ],
      "Feature": [
        "feature request",
        "new model"
      ],
      "Documentation": [
        "documentation"
      ],
      "Question": [
        "question"
      ]
    },
    "godotengine/godot": {
      "Bug": [
        "bug"
      ],
      "Feature": [
        "enhancement"
      ],
      "Documentation": [
        "documentation"
      ],
      "Question": [
        "question"
      ]
    },
    "rust-lang/rust": {
      "Bug": [
        "C-bug"
      ],
      "Feature": [
