        "support:core"
      ]
    },
    "supabase/supabase": {
      "Bug": [
        "bug"
      ],
      "Feature": [
        "enhancement"
      ],
      "Documentation": [
        "documentation"
      ]
    },
    "nextcloud/server": {
      "Bug": [
        "bug"
      ],
      "Feature": [
        "enhancement"
      ]
    },
    "RocketChat/Rocket.Chat": {
