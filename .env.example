# Copy this file to .env (which Git ignores) and fill in what you need.
# Every setting is optional: with none of them, the web page and /predict still work.

# Read-only token: raises the GitHub limit from 60 to 5,000 requests/hour (docs/GITHUB_TOKEN_SETUP.md)
GITHUB_TOKEN=

# Webhook secret: any long random string; paste the same value into the GitHub webhook settings.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# The bot only SUGGESTS unless you switch these on, and only for repos listed here.
BOT_REPOSITORIES=https://github.com/zayn-ish/issue-triage-demo
BOT_POST_COMMENTS=false
BOT_APPLY_LABELS=false

# Optional backup to the webhook: check these repos once a minute (comma-separated).
POLL_REPOSITORIES=
POLL_INTERVAL_SECONDS=60
